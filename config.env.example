# YazKlinik D700 example configuration
# Copy to config.env locally and edit paths/secrets on the target machine.
# Do not commit real API keys, passwords, cookies, tokens, or patient data.

# Data paths
YAZKLINIK_NAS_ROOT=\\asustor\Voluson
YAZKLINIK_DATA_ROOT=D:\YazKlinik_Final_D500\data
YAZKLINIK_MULTIMEDIA_ROOT=D:\YazKlinik_Final_D500\local_multimedia
YAZKLINIK_TEMP_DIR=D:\YazKlinik_Final_D500\temp
YAZKLINIK_EXPORT_ROOT=D:\YazKlinik_Final_D500\exports
YAZKLINIK_VOICE_RECORDS_DIR=D:\YazKlinik_Final_D500\voice_records
YAZKLINIK_DICOM_CACHE_DIR=D:\YazKlinik_Final_D500\dicom_cache
YAZKLINIK_STATE_ROOT=D:\YazKlinik_Final_D500\runtime_state
YAZKLINIK_DB_PATH=D:\YazKlinik_Final_D500\local_db\yazklinik_v68.sqlite3
YAZKLINIK_DB_DIALECT=sqlite
YAZKLINIK_DATABASE_URL=
YAZKLINIK_ENABLE_POSTGRES=0
YAZKLINIK_ALLOW_SQLITE_FALLBACK_ON_PG_BLOCK=1
POSTGRES_HOST=localhost
POSTGRES_PORT=15432
POSTGRES_USER=yazklinik
POSTGRES_DB=yazklinik
POSTGRES_PASSWORD=
PGBOUNCER_HOST=127.0.0.1
PGBOUNCER_PORT=16432
PGBOUNCER_POOL_MODE=transaction
YAZKLINIK_BACKUP_ROOT=D:\YazKlinik_Final_D500\auto_backups

# Web server
YAZKLINIK_WEB_PORT=5443
YAZKLINIK_HTTPS_PORT=5443
YAZKLINIK_ENABLE_HTTPS=1
YAZKLINIK_FORCE_HTTPS_EXTERNAL=0
YAZKLINIK_PUBLIC_BASE_URL=https://example.local:5443
YAZKLINIK_HTTPS_PUBLIC_HOST=example.local
YAZKLINIK_CANONICAL_HOST=example.local
YAZKLINIK_PATIENT_PORTAL_ENABLED=1
YAZKLINIK_PATIENT_PORTAL_BASE_URL=https://hasta.example.local
YAZKLINIK_PATIENT_PORTAL_HOST=127.0.0.1
YAZKLINIK_PATIENT_PORTAL_PORT=5053
YAZKLINIK_PATIENT_PORTAL_PUBLIC_HOSTS=hasta.example.local
# Cloudflare Access guard (critical admin/operator surfaces)
YAZKLINIK_CF_ACCESS_ENFORCE=0
YAZKLINIK_CF_ACCESS_REMOTE_ONLY=1
YAZKLINIK_CF_ACCESS_ALLOWED_EMAILS=
YAZKLINIK_CF_ACCESS_CRITICAL_PREFIXES=/sistem-ayarlari,/tum-ayar-editoru,/operasyon-merkezi,/veritabani-saglik-kontrol,/entegrasyonlar,/hizmet-ajanlari,/ajanlar,/api/agents,/api/entegrasyonlar,/api/system,/api/sistem
YAZKLINIK_HTTPS_HOSTS=localhost,127.0.0.1
YAZKLINIK_WAITRESS_THREADS=16
YAZKLINIK_SERVER_ENGINE=waitress

# Login security (rate limit + 2FA)
YAZKLINIK_LOGIN_RATE_LIMIT_ATTEMPTS=8
YAZKLINIK_LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
YAZKLINIK_LOGIN_RATE_LIMIT_BLOCK_SECONDS=600
YAZKLINIK_LOGIN_2FA_ENABLED=1
YAZKLINIK_LOGIN_2FA_STRICT=1
YAZKLINIK_2FA_REQUIRED_ROLES=doktor,admin

# Sentry (optional)
SENTRY_DSN=
SENTRY_ENV=production
SENTRY_SAMPLE_RATE=0.10

# WebShell / desktop
YAZKLINIK_DESKTOP_MODE=hybrid
YAZKLINIK_DESKTOP_MODE_FORCE=1
YAZKLINIK_DESKTOP_WEB_SHELL=1
YAZKLINIK_WEBSHELL_ENGINE=browser
YAZKLINIK_WEBSHELL_CACHE_MB=1024
YAZKLINIK_WEBSHELL_WINDOWS_ACCELERATOR=1

# Local AI services
YAZKLINIK_RTX5090_STARTUP_PROFILE=1
YAZKLINIK_POWER_PLAN_STARTUP=1
YAZKLINIK_AI_PROVIDER=ollama
YAZKLINIK_OLLAMA_MODEL=qwen2.5:32b
YAZKLINIK_OLLAMA_CTX_LIMIT=8192
YAZKLINIK_OLLAMA_NUM_BATCH=2048
YAZKLINIK_OLLAMA_NUM_GPU=99
YAZKLINIK_OLLAMA_NUM_PARALLEL=2
YAZKLINIK_OLLAMA_MAX_QUEUE=256
YAZKLINIK_OLLAMA_KEEP_ALIVE=8h
YAZKLINIK_OLLAMA_FLASH_ATTENTION=1
YAZKLINIK_OLLAMA_KV_CACHE_TYPE=q8_0
YAZKLINIK_OLLAMA_MAX_LOADED_MODELS=1
YAZKLINIK_OLLAMA_NUM_THREAD=16
PYTORCH_CUDA_ALLOC_CONF=backend:cudaMallocAsync
YAZKLINIK_ALEX_PREWARM=1
YAZKLINIK_ALEX_WAKE_RECORD_SECONDS=3.5
YAZKLINIK_ALEX_COMMAND_RECORD_SECONDS=5.5
YAZKLINIK_ALEX_TTS_PROFILE=tr_lokal_piper
YAZKLINIK_WHISPER_MODEL=D:\YazKlinik_Final_D500\models\whisper\large-v3-turbo
YAZKLINIK_WHISPER_DEVICE=cpu
YAZKLINIK_WHISPER_COMPUTE_TYPE=int8
YAZKLINIK_WHISPER_SERVICE_PORT=9000
YAZKLINIK_XTTS_SERVICE_PORT=9002
YAZKLINIK_XTTS_DEVICE=cpu
YAZKLINIK_XTTS_DEFAULT_VOICE=emel
YAZKLINIK_PIPER_SERVICE_PORT=9001
YAZKLINIK_PIPER_CUDA=0

# Alex SIP / PBX bridge
# Real password stays only in local config.env.
YAZKLINIK_SIP_ENABLED=0
YAZKLINIK_SIP_PBX_HOST=192.168.1.250
YAZKLINIK_SIP_PBX_PORT=5060
YAZKLINIK_SIP_DOMAIN=192.168.1.250
YAZKLINIK_SIP_EXTENSION=19
YAZKLINIK_SIP_PASSWORD=
YAZKLINIK_SIP_LOCAL_IP=
YAZKLINIK_SIP_LOCAL_PORT=5079
YAZKLINIK_SIP_RTP_PORT=40190
YAZKLINIK_SIP_CONTROL_PORT=9019
YAZKLINIK_SIP_AUTO_ANSWER=1
YAZKLINIK_SIP_TTS_VOICE=emel
YAZKLINIK_SIP_RECORD_SECONDS=5.5
YAZKLINIK_SIP_GREETING=Merhaba doktorum. Ben Alex, dahili hattan sizi dinliyorum.

# Voluson
YAZKLINIK_VOLUSON_AUTO_PREFIX=F137230
YAZKLINIK_BK_VOLUSON_MIRROR_ROOT=\\asustor\Voluson\_BK_IMPORTED

# Python
PYTHONUTF8=1
PYTHONIOENCODING=utf-8
PYTHONUNBUFFERED=1

# Optional secrets: keep blank in the example.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
YAZKLINIK_TERMINAL_TOKEN=
YAZKLINIK_NVR_USER=
YAZKLINIK_NVR_PASS=

