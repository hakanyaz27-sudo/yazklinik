# YazKlinik D700 Linux environment template.
# Copy to repo root as .env.linux and edit paths before production use.

PYTHONUTF8=1
YAZKLINIK_WEB_PORT=5052
YAZKLINIK_ENABLE_HTTPS=0
YAZKLINIK_SERVER_ENGINE=gunicorn

# SQLite-safe Gunicorn default: one process, many threads.
# Increase workers only after PostgreSQL primary cutover is verified.
YAZKLINIK_GUNICORN_WORKERS=1
YAZKLINIK_GUNICORN_THREADS=24
YAZKLINIK_GUNICORN_TIMEOUT=300

# Native Linux paths. Keep DB local SSD/NVMe for best speed.
YAZKLINIK_DB_PATH=/opt/yazklinik/d700/local_db/yazklinik_v68.sqlite3
YAZKLINIK_BACKUP_ROOT=/opt/yazklinik/d700/auto_backups
YAZKLINIK_NAS_ROOT=/mnt/yazklinik-voluson
YAZKLINIK_DICOM_CACHE_DIR=/opt/yazklinik/d700/dicom_cache

# Keep SQLite primary until PostgreSQL mirror + readiness are green.
YAZKLINIK_DB_DIALECT=sqlite
YAZKLINIK_DB_PRIMARY=sqlite
YAZKLINIK_ENABLE_POSTGRES=0
YAZKLINIK_POSTGRES_MODE=shadow
YAZKLINIK_DATABASE_URL=postgresql://yazklinik:CHANGE_ME@127.0.0.1:15432/yazklinik
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=15432
POSTGRES_USER=yazklinik
POSTGRES_DB=yazklinik

# Optional perf logs.
YAZKLINIK_PERF_SLOW_MS=1200
YAZKLINIK_PERF_LOG_MAX_BYTES=5242880
